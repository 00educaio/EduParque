# Modelo para desenvolvimento local.
# Preview e produção usam segredos do Wrangler; consulte docs/deployment-environments.md.

# PostgreSQL local (Docker Compose)
DATABASE_URL=postgresql://eduparque:eduparque@localhost:5432/eduparque

# Usada pelo Wrangler para emular o binding Hyperdrive no preview local.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://eduparque:eduparque@localhost:5432/eduparque

# Auth.js. Gere com: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TRUST_HOST=true
# Necessario para builds usados por varias replicas (base64 AES 32 bytes)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# local | postgres | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage

# Storage S3-compatible (necessario somente quando STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
