# PostgreSQL local (Docker Compose)
DATABASE_URL=postgresql://eduparque:eduparque@localhost:5432/eduparque
# Em Production, preserve o banco Neon Sao Paulo atual e use o endpoint pooled
# (hostname com sufixo -pooler). Em Preview, use uma branch/URL separada.

# Auth.js. Gere com: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TRUST_HOST=true
# Necessario para builds usados por varias replicas (base64 AES 32 bytes)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Login local sem OAuth/SMTP. Ignorado automaticamente em producao.
DEV_AUTH_ENABLED=true

# Google OAuth (opcional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic Link por SMTP (opcional)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=EduParque <no-reply@example.com>

# Segredo para autorizar /api/cron/* (gere um valor aleatorio independente)
CRON_SECRET=

# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage

# Storage S3-compatible (necessario somente quando STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# URLs assinadas curtas e expiracao de uploads incompletos
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_READ_URL_TTL_SECONDS=900
MEDIA_PENDING_TTL_MINUTES=60
TEAM_IMAGE_TTL_HOURS=24
