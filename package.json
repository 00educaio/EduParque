{
  "name": "eduparque",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/shared/infrastructure/database/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --conditions react-server --import tsx src/shared/infrastructure/database/seed.ts",
    "auth:user": "node --env-file-if-exists=.env --conditions react-server --import tsx scripts/manage-auth-user.ts",
    "storage:import-local": "node --env-file-if-exists=.env --conditions react-server --import tsx src/shared/infrastructure/database/import-local-storage.ts",
    "db:studio": "drizzle-kit studio",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && node --env-file=.env ./node_modules/@opennextjs/cloudflare/dist/cli/index.js preview",
    "cf:preview:remote": "opennextjs-cloudflare build && wrangler preview --name deploy-cloudflare",
    "cf:deploy": "opennextjs-cloudflare build && node --env-file=.env ./node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy",
    "cf:upload": "opennextjs-cloudflare build && node --env-file=.env ./node_modules/@opennextjs/cloudflare/dist/cli/index.js upload"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@aws-sdk/client-s3": "^3.901.0",
    "@opennextjs/cloudflare": "1.20.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "file-type": "^21.0.0",
    "lucide-react": "^0.544.0",
    "next": "^16.3.8",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3",
    "wrangler": "4.151.0"
  }
}
